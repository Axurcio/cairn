# Python configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Optional ArcKit configuration
ARCKIT_PROFILE=development
ARCKIT_TEMPLATES_DIR=.arckit/templates

# Applied to git config user.name / user.email by the devcontainer
# (post-create + post-start). Required to avoid "tell me who you are" on commit.
GIT_USERNAME=YOUR_GIT_USERNAME
GIT_EMAIL=YOUR_GIT_EMAIL
# GitHub PAT with repo access and SAML SSO authorized for imdex-data-mesh-platform
GIT_PAT=YOUR_GITHUB_PAT

AZDO_USERNAME=YOUR_AZDO_USERNAME
AZDO_PAT=YOUR_AZDO_PAT
AZDO_REPO_URL=https://dev.azure.com/ImdexDevOps/Data-Platform/_git/arc-kit

AZURE_DEVOPS_EXT_PAT=""
CONFLUENCE_INSTANCE=""
ATLASSIAN_EMAIL_ADDRESS=""
ATLASSIAN_API_TOKEN=" "
CONFLUENCE_SPACE_KEY=""